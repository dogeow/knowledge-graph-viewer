{
  "name": "knowledge-graph-viewer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
